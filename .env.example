# Required
OPENAI_API_KEY=sk-...

# Optional overrides
ASR_MODEL=whisper-1
TRANSLATOR_MODEL=gpt-4o-mini
TTS_VOICE=hi-IN-MadhurNeural

# VAD tuning (milliseconds)
VAD_AGGRESSIVENESS=2
VAD_SILENCE_MS=500
VAD_MIN_SPEECH_MS=300

# Sample rate of inbound PCM from the browser (must be 8000/16000/32000/48000 for webrtcvad)
SAMPLE_RATE=16000

# Queue bounds (drop-oldest on overflow)
AUDIO_QUEUE_MAX=200
ASR_QUEUE_MAX=8
TRANSLATION_QUEUE_MAX=8
TTS_QUEUE_MAX=8
PLAYBACK_QUEUE_MAX=64

# Logging
LOG_LEVEL=INFO
